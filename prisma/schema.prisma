generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// 1. User & Authentication (Better Auth Compatible)
// ----------------------------------------------------
model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  emailVerified Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  accounts      Account[]
  sessions      Session[]
  devices       Device[]
  deviceSessions DeviceSession[]
  recordings    Recording[]
  auditLogs     AuditLog[]
  notifications Notification[]
  settings      UserSettings?

  @@map("users")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ----------------------------------------------------
// 2. Device Management
// ----------------------------------------------------
model Device {
  id            String          @id @default(cuid())
  userId        String
  deviceName    String
  browserInfo   String?
  osInfo        String?
  status        String          @default("offline") // "online" | "offline" | "blocked"
  lastOnlineAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      DeviceSession[]
  consents      Consent[]
  recordings    Recording[]

  @@map("devices")
}

// ----------------------------------------------------
// 3. Device Sessions & Join Links
// ----------------------------------------------------
model DeviceSession {
  id          String      @id @default(cuid())
  userId      String
  deviceId    String?
  status      String      @default("pending") // "pending" | "connected" | "revoked" | "expired"
  expiresAt   DateTime
  usageLimit  Int         @default(1)
  usageCount  Int         @default(0)
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device      Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  joinTokens  JoinToken[]
  consents    Consent[]
  recordings  Recording[]
  auditLogs   AuditLog[]

  @@map("device_sessions")
}

model JoinToken {
  id          String        @id @default(cuid())
  sessionId   String
  hashedToken String        @unique
  expiresAt   DateTime
  isUsed      Boolean       @default(false)
  usedAt      DateTime?
  createdAt   DateTime      @default(now())

  session     DeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("join_tokens")
}

// ----------------------------------------------------
// 4. Privacy & Consent Management
// ----------------------------------------------------
model Consent {
  id               String        @id @default(cuid())
  sessionId        String
  deviceId         String?
  cameraAllowed    Boolean       @default(false)
  audioAllowed     Boolean       @default(false)
  recordingAllowed Boolean       @default(false)
  ipAddress        String?
  userAgent        String?
  consentedAt      DateTime      @default(now())

  session          DeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  device           Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@map("consents")
}

// ----------------------------------------------------
// 5. Recording Metadata
// ----------------------------------------------------
model Recording {
  id                      String         @id @default(cuid())
  userId                  String
  deviceId                String?
  sessionId               String?
  fileName                String
  fileFormat              String         @default("webm")
  fileSizeBytes           BigInt         @default(0)
  durationSeconds         Int            @default(0)
  startedAt               DateTime
  endedAt                 DateTime?
  saveStatus              String         @default("saved_locally") // "saved_locally" | "downloaded" | "failed"
  saveLocationDescription String?
  createdAt               DateTime       @default(now())

  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device                  Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  session                 DeviceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@map("recordings")
}

// ----------------------------------------------------
// 6. Security Audit Logging
// ----------------------------------------------------
model AuditLog {
  id          String         @id @default(cuid())
  userId      String?
  sessionId   String?
  eventType   String         // e.g., "SESSION_CREATED", "CAMERA_CONSENT_GRANTED", "RECORDING_STARTED"
  description String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  session     DeviceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ----------------------------------------------------
// 7. Notifications
// ----------------------------------------------------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "DEVICE_CONNECT" | "DEVICE_DISCONNECT" | "RECORDING_START" | "RECORDING_STOP"
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ----------------------------------------------------
// 8. User Settings
// ----------------------------------------------------
model UserSettings {
  id                            String   @id @default(cuid())
  userId                        String   @unique
  defaultVideoQuality           String   @default("720p") // "480p" | "720p" | "1080p"
  preferredResolution           String   @default("1280x720")
  defaultAudioEnabled           Boolean  @default(false)
  defaultRecordingFormat        String   @default("video/webm;codecs=vp8")
  localSavePreference           String   @default("prompt") // "filesystem_api" | "download"
  defaultSessionExpiryMinutes   Int      @default(60)
  defaultUsageLimit             Int      @default(1)
  notifyOnConnect               Boolean  @default(true)
  notifyOnRecord                Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  user                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
